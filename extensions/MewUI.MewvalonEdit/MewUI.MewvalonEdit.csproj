  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MewUI\MewUI.csproj" />
    <None Include="LICENSE.AvalonEdit" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

</Project>

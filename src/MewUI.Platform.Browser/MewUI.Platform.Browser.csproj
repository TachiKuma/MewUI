<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/MewUI.Common.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>$(MewUITitle).Platform.Browser</AssemblyName>
    <PackageId>$(MewUITitle).Platform.Browser</PackageId>
    <Description>Browser canvas platform host for $(MewUITitle)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MewUI/MewUI.csproj" AdditionalProperties="MewUITargetFrameworks=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page-side half of the platform; the package targets serve it from a browser app's wwwroot. -->
    <None Include="wwwroot/**" Pack="true" PackagePath="buildTransitive/wwwroot/" />
    <None Include="..\..\build\$(MewUITitle).Platform.Browser.targets" Link="buildTransitive\$(MewUITitle).Platform.Browser.targets"
          Pack="true" PackagePath="buildTransitive\" Visible="false" />
  </ItemGroup>

</Project>

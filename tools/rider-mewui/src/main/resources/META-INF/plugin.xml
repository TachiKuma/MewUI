<idea-plugin>
  <id>com.aprillz.mewui.preview</id>
  <name>MewUI Preview</name>
  <vendor>Aprillz</vendor>
  <description><![CDATA[
    Live editor preview for MewUI windows and user controls: build once, then every save
    updates the preview through .NET Hot Reload.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.rider</depends>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="MewUI Preview" anchor="right" canCloseContents="false"
                icon="/icons/toolWindowMewUI.svg"
                factoryClass="com.aprillz.mewui.preview.PreviewToolWindowFactory" />
  </extensions>
  <actions>
    <action id="MewUI.Preview.Open" class="com.aprillz.mewui.preview.OpenPreviewAction"
            text="Open MewUI Preview" description="Preview this file's MewUI window or user control"
            icon="/icons/toolWindowMewUI.svg">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
